{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "noEmit": true,
    "declaration": true,
    "declarationDir": "dist",
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx"
  }
}
